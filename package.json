{
  "name": "zeporah-pilot",
  "private": true,
  "version": "0.1.0",
  "description": "Zeporah hospice-first care coordination — synthetic pilot prototype (development environment only).",
  "type": "module",
  "scripts": {
    "dev": "ZEPORAH_DEV_SIGN_IN=1 bun --bun vite dev --port 3000",
    "build": "bun --bun vite build",
    "db:reset": "bun scripts/db-reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run tests/unit",
    "test:integration": "bun --bun vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:readonly": "playwright test --config playwright.readonly.config.ts",
    "test:e2e:verify": "playwright test --config playwright.verify.config.ts",
    "test:e2e:upgrade": "playwright test --config playwright.upgrade.config.ts",
    "test:all": "bun run typecheck && bun run test && bun run test:e2e",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "drizzle-orm": "^0.45.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "3.7.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.8.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
